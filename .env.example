# Copy to .env and fill in. `.env` is gitignored; these three values are the app's entire
# configuration, and all three are read at build time into BuildConfig.
#
# CHATTY_API_KEY     the shared demo key for https://kamartaj.xyz — the brain.
# LIVEAVATAR_API_KEY app.liveavatar.com/developers. NOT a HeyGen key: HeyGen's streaming API was
#                    sunset in March 2026 and a HeyGen key is rejected here with code 4001.
# ELEVENLABS_API_KEY the voice. Must belong to the same workspace as the voice ids in
#                    app/src/main/assets/agents.json — a voice id is workspace-scoped.
CHATTY_API_KEY=
LIVEAVATAR_API_KEY=
ELEVENLABS_API_KEY=

# Release signing, needed only to build a distributable beta APK (`:app:assembleRelease`).
# Without these the release build falls back to the debug key and must not be handed to testers.
# Create the keystore once, keep it backed up outside the repo, and never commit it:
#
#   keytool -genkeypair -v -keystore chatty-release.jks -alias chatty \
#     -keyalg RSA -keysize 4096 -validity 10000 \
#     -dname "CN=Chatty, O=OCBC, C=ID"
#
# KEYSTORE_PATH may be absolute or relative to the repo root.
KEYSTORE_PATH=
KEYSTORE_PASSWORD=
KEY_ALIAS=chatty
# Optional: defaults to KEYSTORE_PASSWORD, which is what the keytool command above produces.
KEY_PASSWORD=

# Telemetry. All four are optional, and the app is fully functional without any of them.
#
# They belong to two different things, and conflating them is the usual confusion. SENTRY_DSN is
# read by the app at runtime and is the whole of the telemetry: turns, timings, spans. The other
# three are never read by the app at all — they are build-machine credentials for the Gradle plugin,
# and the only thing they change is whether a release crash arrives as a readable stack trace.
#
# SENTRY_DSN decides where completed turns go. Unset, they are written to logcat and travel no
# further — which is the right setting for a developer's handset. Set, each turn becomes one
# transaction with a span per leg. It is not a secret: a DSN is designed to ship inside a client,
# and it only grants the ability to write events to this project.
#
# WHAT IS SENT IS NOT DECIDED HERE. It is decided in TelemetryPolicy, in core:ai — one documented
# field per decision, defaulting to the conservative side. Read that file before turning this on.
SENTRY_DSN=

# The remaining three are build-time only. They exist for one job: uploading R8's mapping file so
# that release crashes arrive as readable stack traces rather than obfuscated frames. Nothing in the
# app reads them, none of them is compiled into the APK, and no telemetry depends on them. All three
# are required together; with any missing the upload is skipped and the build still succeeds.
#
# Unlike the DSN, SENTRY_AUTH_TOKEN *is* a secret — it is an organisation-scoped credential, not a
# per-project write key. Keep it out of shared machines and prefer supplying it through CI's
# environment rather than a file.
SENTRY_AUTH_TOKEN=
# The slugs from the Sentry URL, e.g. sentry.io/organizations/<org>/projects/<project>/ — these are
# names, not the numeric ids that appear inside the DSN.
SENTRY_ORG=
SENTRY_PROJECT=
