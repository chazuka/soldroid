<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Hold-to-talk. Transcription happens on the device; the recording itself never leaves it —
         only the recognised text is sent, and only to the chat API. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      A conversation keeps running while the handset sleeps, which is the whole point of handsfree.
      The microphone type is what makes the recogniser legal once the activity has stopped, and the
      media-playback type is what keeps the agent audible. See ConversationService.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      LiveKit's manifest declares CAMERA and MEDIA_PROJECTION because its SDK can publish a local
      video track or a screen share. This app never does either: the avatar arrives as a remote
      track and is only ever subscribed to. Left in place the permissions would show on the install
      listing — an OCBC-branded app asking for the camera — for a capability that cannot be reached.

      If a future screen does publish video, delete the matching line here rather than requesting
      the permission somewhere else, or the merged manifest will silently keep it out.
    -->
    <uses-permission android:name="android.permission.CAMERA" tools:node="remove" />

    <!-- Android 11+ package visibility: without this the system speech recogniser is invisible to
         the app and `SpeechRecognizer.isRecognitionAvailable` answers false on a device that has one. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".ChattyApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chatty">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Chatty">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    
        <service
            android:name=".companion.ConversationService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback" />

</application>
</manifest>
