<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose paints every surface; this exists only so the window before the first frame is the
         app's paper rather than the platform's cool grey. -->
    <style name="Theme.Chatty" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
