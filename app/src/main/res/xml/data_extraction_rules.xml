<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or transferred. The app holds a transcript and two vendor sessions, none of
     which survives a reinstall meaningfully, and a cloud copy of a conversation about someone's
     money is a liability with no matching benefit. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
